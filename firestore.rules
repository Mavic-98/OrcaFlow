rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil da empresa/usuário — só o dono pode ler/escrever o próprio perfil
    match /usuarios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Clientes — só o dono (uid) pode ler/editar/apagar seus próprios clientes
    match /clientes/{clienteId} {
      allow read, update, delete: if request.auth != null
                                    && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
                     && request.resource.data.uid == request.auth.uid;
    }

    // Orçamentos — mesma regra: só o dono (uid) acessa os próprios orçamentos
    match /orcamentos/{orcamentoId} {
      allow read, update, delete: if request.auth != null
                                    && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
                     && request.resource.data.uid == request.auth.uid;
    }
  }
}
